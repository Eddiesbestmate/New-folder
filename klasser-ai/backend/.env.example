# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key - BYPASSES ROW LEVEL SECURITY.
# Server-side only. Never expose to the frontend, never log it.
SUPABASE_SERVICE_KEY=
# Settings > Database > Connection string > URI (asyncpg accepts postgresql://)
DATABASE_URL=

# --- Encryption ---
# Encrypts AI provider keys stored in the api_keys table. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- Anthropic ---
# Not used in the VCE build. Add post-VCE for the commercial upgrade.
# ANTHROPIC_API_KEY=

# Email (Phase 12). RESEND_FROM overrides the sender - set it to
# onboarding@resend.dev to send without verifying a domain first.
RESEND_API_KEY=
RESEND_FROM=
